{
  "name": "license-sentinel",
  "version": "1.1.0",
  "description": "License compliance gate for npm projects: reads node_modules and npm/pnpm/yarn lockfiles, resolves SPDX expressions and LICENSE texts, enforces allow/deny lists, presets and project-license compatibility, and emits CycloneDX 1.6 and SPDX 2.3 SBOMs, NOTICES, and text/JSON/SARIF/Markdown/CSV/HTML reports. Zero runtime deps.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "license-sentinel": "bin/license-sentinel.js"
  },
  "files": [
    "dist",
    "src/schemas",
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "license",
    "licenses",
    "license-checker",
    "license-compliance",
    "spdx",
    "sbom",
    "cyclonedx",
    "notices",
    "attribution",
    "gpl",
    "open-source",
    "compliance",
    "sarif",
    "cli",
    "github-action",
    "devsecops",
    "supply-chain-security"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/license-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/license-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/license-sentinel/",
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
